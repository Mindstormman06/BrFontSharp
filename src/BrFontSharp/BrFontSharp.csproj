<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TexSharp is a submodule in lib. A program that uses several of these libraries sets FontLibRoot so they share one. -->
    <FontLibRoot Condition="'$(FontLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\lib</FontLibRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BrFontSharp</RootNamespace>
    <AssemblyName>BrFontSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>NW4R BRFNT and BRFNA font reader and writer, with glyph lookup and rendering through TexSharp.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FontLibRoot)\TexSharp\src\TexSharp\TexSharp.csproj" />
  </ItemGroup>

</Project>
